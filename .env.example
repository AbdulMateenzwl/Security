# Copy to .env and fill in — or just run ./scripts/gen-secrets.sh to generate it.
# .env is gitignored; never commit real secrets.

# Which Spring profile the backend runs. `prod` enforces strong secrets + real JWT
# keys (recommended for deployment). Use `dev` for a relaxed local run (ephemeral
# JWT keys, verbose logging).
SPRING_PROFILES_ACTIVE=prod

# Host port the app (nginx) is published on.
WEB_PORT=80

# Strong, non-default values — the prod profile refuses to start otherwise.
DB_PASSWORD=
REDIS_PASSWORD=

# RSA key pair for RS256 JWTs, as PEM. A single-line base64 body (no armor / no
# newlines) is accepted — the backend strips PEM armor and whitespace itself.
# Required under the prod profile; leave blank under dev (ephemeral keys are used).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Public origin of the deployed app (used for CORS under the prod profile).
FRONTEND_ORIGIN=http://localhost
