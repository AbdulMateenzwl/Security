meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setEnvVar("refreshToken", res.body.refreshToken);
    bru.setEnvVar("userId", res.body.user.id);
    console.log("Logged in userId=" + res.body.user.id);
  }
}

tests {
  test("login ok", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a("string");
  });
}

docs {
  Logs in with {{username}} / {{password}} and stores accessToken, refreshToken and userId
  in the environment. Run this first — most other requests need {{accessToken}}.
}
