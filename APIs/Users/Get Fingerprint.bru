meta {
  name: Get Fingerprint
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/{{peerId}}/fingerprint
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // Resolve peerId from peerUsername if it isn't set yet, so this works standalone.
  if (!bru.getEnvVar("peerId")) {
    const base = bru.getEnvVar("baseUrl");
    const token = bru.getEnvVar("accessToken");
    const q = bru.getEnvVar("peerUsername");
    if (typeof fetch === "function" && base && token && q) {
      const r = await fetch(base + "/api/users/search?q=" + encodeURIComponent(q), {
        headers: { Authorization: "Bearer " + token },
      });
      if (r.ok) {
        const users = await r.json();
        if (Array.isArray(users) && users.length) {
          bru.setEnvVar("peerId", users[0].id);
        }
      }
    }
  }
  if (!bru.getEnvVar("peerId")) {
    throw new Error("peerId is not set. Run 'Auth / Login' then 'Users / Search Peer' first.");
  }
}

docs {
  Returns a user's identity-key fingerprint (safety number), or null if they have not
  published keys yet. `fingerprint: null` means that user has never provisioned — a peer
  cannot start an encrypted session with them until they do.
  Auto-fills {{peerId}} from {{peerUsername}}; swap the URL to {{userId}} to check your own.
}
