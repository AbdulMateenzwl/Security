meta {
  name: Get History
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/chats/{{chatId}}/messages?limit=30
  body: none
  auth: bearer
}

params:query {
  limit: 30
  ~before:
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("history ok", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Newest-first page of {{chatId}}'s messages (default limit 30). To page backwards, enable
  the `before` query param and set it to the oldest message id you already hold.
}
