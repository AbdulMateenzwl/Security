meta {
  name: Get Chat
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/chats/{{chatId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Returns the chat {{chatId}} with its members. Authorization is enforced server-side — a
  non-member gets 403 (not 404).
}
